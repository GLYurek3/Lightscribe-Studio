#!/usr/bin/env bash
# Launch LightScribe Studio. Optional argument: image to open.
DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
LOG="${XDG_CACHE_HOME:-$HOME/.cache}/lightscribe-studio/app.log"
mkdir -p "$(dirname "$LOG")"
exec julia --project="$DIR" --startup-file=no -e 'using LightScribeStudio; LightScribeStudio.main()' "$@" >>"$LOG" 2>&1
